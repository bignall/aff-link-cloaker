{
	"name": "arbe/aff-link-cloaker",
	"description": "Import affiliate offers (WarriorPlus first) and turn them into cloaked, trackable redirect links.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1",
		"bignall/wp-foundation": "^0.1.1"
	},
	"require-dev": {
		"brianhenryie/strauss": "^0.19"
	},
	"autoload": {
		"psr-4": {
			"AffLinkCloaker\\": "src/"
		}
	},
	"extra": {
		"strauss": {
			"target_directory": "vendor-prefixed",
			"namespace_prefix": "AffLinkCloaker\\Vendor\\",
			"classmap_prefix": "AffLinkCloaker_Vendor_",
			"packages": [
				"bignall/wp-foundation"
			],
			"delete_vendor_packages": true
		}
	},
	"scripts": {
		"prefix-namespaces": [
			"strauss",
			"@composer dump-autoload"
		],
		"post-install-cmd": [
			"@prefix-namespaces"
		],
		"post-update-cmd": [
			"@prefix-namespaces"
		]
	},
	"config": {
		"platform": {
			"php": "8.1.0"
		},
		"platform-check": false,
		"sort-packages": true
	}
}
